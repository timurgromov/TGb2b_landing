---
import BaseLayout from '@layouts/BaseLayout.astro';
import Benefits from '@components/Benefits.astro';
import CaseProofs from '@components/CaseProofs.astro';
import ContextPhoto from '@components/ContextPhoto.astro';
import EveningFlow from '@components/EveningFlow.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';
import Gallery from '@components/Gallery.astro';
import Header from '@components/Header.astro';
import HeroPortraitSlider from '@components/HeroPortraitSlider.astro';
import Letters from '@components/Letters.astro';
import Modals from '@components/Modals.astro';
import MusicProgram from '@components/MusicProgram.astro';
import ServiceFormats from '@components/ServiceFormats.astro';
import VideoCases from '@components/VideoCases.astro';
import ContactChoice from '@components/ContactChoice.astro';
import MaterialsRequest from '@components/MaterialsRequest.astro';
import CorporateLeadForm from '@components/CorporateLeadForm.astro';
import { contact } from '@data/corporate';

const canonical = 'https://corp.timurgromov.ru/novogodniy-korporativ/';
const title = 'Ведущий на новогодний корпоратив в Москве — Тимур Громов';
const description =
  'Ведущий на новогодний корпоратив в Москве: современная программа, DJ, звук и спокойная подготовка по договору. Проверьте свободную дату.';

const workflowSteps = [
  ['Проверка даты', 'Вы оставляете дату и число гостей. Я сверяю календарь и отвечаю лично.'],
  ['Знакомство', 'Коротко обсуждаем компанию, аудиторию, площадку и задачу вечера.'],
  ['Концепция и смета', 'Определяем программу, состав команды, технику и финальную стоимость.'],
  ['Договор и подготовка', 'Фиксируем условия, собираем тайминг, имена, награждения и подрядчиков.'],
  ['Корпоратив', 'Провожу вечер в согласованном стиле и держу общий темп мероприятия.']
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ведущий на новогодний корпоратив',
  description,
  url: canonical,
  areaServed: { '@type': 'City', name: 'Москва' },
  provider: {
    '@type': 'Person',
    name: contact.name,
    telephone: contact.phoneSchema,
    email: contact.email,
    image: 'https://corp.timurgromov.ru/assets/hero/portrait.webp'
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://corp.timurgromov.ru/assets/og_og.jpg?v=4"
  includeMainAssets
  pageCss="/seasonal.css?v=20261009b"
  pageScript="/seasonal.js?v=20261009b"
  structuredData={serviceSchema}
>
  <Header page="new_year" />

  <main class="page seasonal-page">
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__text sr" id="hero-left">
          <h1><span class="h1-prefix">Ведущий на новогодний корпоратив в Москве</span></h1>
          <p class="sub" id="hero-subtitle">Тимур Громов — ведущий, который держит темп вечера, бережно вовлекает гостей и собирает программу под характер вашей компании.</p>
          <div class="hero-tags" id="hero-tags">
            <span class="tag">Декабрь</span>
            <span class="tag">15+ лет опыта</span>
            <span class="tag tag-radio">Ведущий Love Radio</span>
            <span class="tag">10 лет КВН</span>
            <span class="tag">800+ мероприятий</span>
            <span class="tag tag-humor">Добрый юмор</span>
            <span class="tag">Договор ИП</span>
          </div>
          <div class="hero__cta hero-actions" id="hero-actions">
            <button type="button" class="btn btn-primary" data-contact-open data-contact-source="hero_consultation" data-contact-intent="consultation" data-contact-placement="hero" data-testid="seasonal-primary-cta">Обсудить корпоратив</button>
            <button type="button" class="btn btn-outline" data-contact-open data-contact-form="video" data-form-source="hero_video" data-contact-intent="meeting" data-contact-placement="hero">Назначить встречу</button>
          </div>
        </div>

        <HeroPortraitSlider alt="Тимур Громов — ведущий на новогодний корпоратив" />
      </div>
    </section>

    <VideoCases />
    <EveningFlow seasonal />
    <Benefits />
    <ServiceFormats pricing />
    <MusicProgram seasonal />
    <CaseProofs seasonal />

    <section id="workflow" class="workflow section">
      <div class="container">
        <h2 class="section__title sr">Порядок работы</h2>
        <p class="section__subtitle sr">От проверки даты — до самого корпоратива</p>
        <div class="workflow__steps">
          {workflowSteps.map(([stepTitle, text], index) => (
            <article class="workflow__step sr" role="group" aria-label={`Этап ${index + 1} из ${workflowSteps.length}`}>
              <span class="workflow__badge" aria-hidden="true">{index + 1}</span>
              <div class="workflow__content">
                <h3 class="workflow__title">{stepTitle}</h3>
                <p class="workflow__text">{text}</p>
              </div>
            </article>
          ))}
        </div>
        <svg class="workflow__connector" aria-hidden="true" viewBox="0 0 1200 200">
          <defs>
            <linearGradient id="seasonalConnectorGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:var(--accent);stop-opacity:0"></stop>
              <stop offset="100%" style="stop-color:var(--accent);stop-opacity:0.5"></stop>
            </linearGradient>
          </defs>
          <path class="workflow__path" d="M 50 60 Q 250 10 450 60 T 1200 60" stroke="url(#seasonalConnectorGradient)" stroke-width="2" fill="none" stroke-dasharray="1000" stroke-dashoffset="1000"></path>
        </svg>
      </div>
      <div class="workflow__cta">
        <a class="btn btn-outline" href="#proverit-datu">Получить расчёт</a>
      </div>
    </section>

    <MaterialsRequest />
    <Gallery />
    <Letters />
    <FAQ />
    <ContextPhoto variant="formats" />

    <CorporateLeadForm page="new_year" />
  </main>

  <Footer />
  <Modals />
  <ContactChoice page="new_year" />
</BaseLayout>
