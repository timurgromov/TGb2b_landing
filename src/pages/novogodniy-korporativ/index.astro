---
import BaseLayout from '@layouts/BaseLayout.astro';
import Benefits from '@components/Benefits.astro';
import CaseProofs from '@components/CaseProofs.astro';
import ContextPhoto from '@components/ContextPhoto.astro';
import EveningFlow from '@components/EveningFlow.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';
import Gallery from '@components/Gallery.astro';
import Header from '@components/Header.astro';
import HeroPortraitSlider from '@components/HeroPortraitSlider.astro';
import Letters from '@components/Letters.astro';
import Modals from '@components/Modals.astro';
import MusicProgram from '@components/MusicProgram.astro';
import ServiceFormats from '@components/ServiceFormats.astro';
import VideoCases from '@components/VideoCases.astro';
import WhatsAppFab from '@components/WhatsAppFab.astro';
import { contact } from '@data/corporate';

const canonical = 'https://corp.timurgromov.ru/novogodniy-korporativ/';
const title = 'Ведущий на новогодний корпоратив в Москве — Тимур Громов';
const description =
  'Ведущий на новогодний корпоратив в Москве: современная программа, DJ, звук и спокойная подготовка по договору. Проверьте свободную дату.';

const workflowSteps = [
  ['Проверка даты', 'Вы оставляете дату и число гостей. Я сверяю календарь и отвечаю лично.'],
  ['Знакомство', 'Коротко обсуждаем компанию, аудиторию, площадку и задачу вечера.'],
  ['Концепция и смета', 'Определяем программу, состав команды, технику и финальную стоимость.'],
  ['Договор и подготовка', 'Фиксируем условия, собираем тайминг, имена, награждения и подрядчиков.'],
  ['Корпоратив', 'Провожу вечер в согласованном стиле и держу общий темп мероприятия.']
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ведущий на новогодний корпоратив',
  description,
  url: canonical,
  areaServed: { '@type': 'City', name: 'Москва' },
  provider: {
    '@type': 'Person',
    name: contact.name,
    telephone: contact.phoneSchema,
    email: contact.email,
    image: 'https://corp.timurgromov.ru/assets/hero/portrait.webp'
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://corp.timurgromov.ru/assets/og_og.jpg?v=4"
  includeMainAssets
  pageCss="/seasonal.css?v=20260930c"
  pageScript="/seasonal.js?v=20261001b"
  structuredData={serviceSchema}
>
  <Header />

  <main class="page seasonal-page">
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__text sr" id="hero-left">
          <h1><span class="h1-prefix">Ведущий на новогодний корпоратив в Москве</span></h1>
          <p class="sub" id="hero-subtitle">Тимур Громов — ведущий, который держит темп вечера, бережно вовлекает гостей и собирает программу под характер вашей компании.</p>
          <div class="hero-tags" id="hero-tags">
            <span class="tag">Декабрь</span>
            <span class="tag">15+ лет опыта</span>
            <span class="tag tag-radio">Ведущий Love Radio</span>
            <span class="tag">10 лет КВН</span>
            <span class="tag">800+ мероприятий</span>
            <span class="tag tag-humor">Добрый юмор</span>
            <span class="tag">Договор ИП</span>
          </div>
          <div class="hero__cta hero-actions" id="hero-actions">
            <a class="btn btn-primary" href="#proverit-datu" data-testid="seasonal-primary-cta">Проверить дату</a>
            <a class="btn btn-outline" href="#cases">Посмотреть видео</a>
          </div>
        </div>

        <HeroPortraitSlider alt="Тимур Громов — ведущий на новогодний корпоратив" />
      </div>
    </section>

    <VideoCases />
    <EveningFlow seasonal />
    <Benefits />
    <ServiceFormats seasonal />
    <MusicProgram seasonal />
    <CaseProofs seasonal />

    <section id="workflow" class="workflow section">
      <div class="container">
        <h2 class="section__title sr">Порядок работы</h2>
        <p class="section__subtitle sr">От проверки даты — до самого корпоратива</p>
        <div class="workflow__steps">
          {workflowSteps.map(([stepTitle, text], index) => (
            <article class="workflow__step sr" role="group" aria-label={`Этап ${index + 1} из ${workflowSteps.length}`}>
              <span class="workflow__badge" aria-hidden="true">{index + 1}</span>
              <div class="workflow__content">
                <h3 class="workflow__title">{stepTitle}</h3>
                <p class="workflow__text">{text}</p>
              </div>
            </article>
          ))}
        </div>
        <svg class="workflow__connector" aria-hidden="true" viewBox="0 0 1200 200">
          <defs>
            <linearGradient id="seasonalConnectorGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:var(--accent);stop-opacity:0"></stop>
              <stop offset="100%" style="stop-color:var(--accent);stop-opacity:0.5"></stop>
            </linearGradient>
          </defs>
          <path class="workflow__path" d="M 50 60 Q 250 10 450 60 T 1200 60" stroke="url(#seasonalConnectorGradient)" stroke-width="2" fill="none" stroke-dasharray="1000" stroke-dashoffset="1000"></path>
        </svg>
      </div>
      <div class="workflow__cta">
        <a class="btn btn-outline" href="#proverit-datu">Получить расчёт</a>
      </div>
    </section>

    <Gallery />
    <Letters />
    <FAQ />
    <ContextPhoto variant="formats" />

    <section id="proverit-datu" class="section cta seasonal-lead-section">
      <div class="container">
        <div class="cta__box sr seasonal-lead-card">
          <h2 class="cta__title">Проверьте дату и получите расчёт</h2>
          <p class="cta__subtitle">Укажите основные параметры корпоратива. Я сверю календарь и отвечу лично.</p>

          <form class="seasonal-form" data-testid="seasonal-lead-form" data-seasonal-form novalidate>
            <div class="seasonal-form__grid">
              <label>
                <span>Дата мероприятия</span>
                <input type="date" name="event_date" min="2026-12-01" max="2026-12-31" required />
              </label>
              <label>
                <span>Количество гостей</span>
                <input type="number" name="guests_count" min="10" max="1000" inputmode="numeric" placeholder="Например, 80" required />
              </label>
              <label>
                <span>Какой состав нужен?</span>
                <select name="equipment_needed" required>
                  <option value="">Выберите вариант</option>
                  <option value="host_dj">Ведущий + DJ</option>
                  <option value="host_dj_sound">Ведущий + DJ + аппаратура</option>
                  <option value="host_dj_sound_vocalists">Ведущий + DJ + аппаратура + 3 блока по 30 минут: два вокалиста</option>
                  <option value="host_dj_sound_vocalists_sax">Ведущий + DJ + аппаратура + 3 блока по 30 минут: два вокалиста и саксофонист</option>
                  <option value="host_dj_sound_vocalists_sax_guitar">Ведущий + DJ + аппаратура + 3 блока по 30 минут: два вокалиста, саксофонист и гитарист</option>
                  <option value="unknown">Пока не знаю</option>
                </select>
              </label>
              <label>
                <span>Компания или площадка <small>необязательно</small></span>
                <input type="text" name="company" maxlength="160" autocomplete="organization" placeholder="Название компании или площадки" />
              </label>
              <label>
                <span>Как к вам обращаться</span>
                <input type="text" name="name" maxlength="120" autocomplete="name" placeholder="Имя" required />
              </label>
              <label>
                <span>Телефон</span>
                <input type="tel" name="phone" maxlength="30" autocomplete="tel" inputmode="tel" placeholder="+7 999 000-00-00" required />
              </label>
            </div>

            <div class="cta__actions seasonal-form__actions">
              <button class="btn btn-primary" type="submit">Проверить дату</button>
            </div>
            <p class="seasonal-form__status" data-form-status role="status" aria-live="polite"></p>
            <p class="seasonal-form__consent">Нажимая «Проверить дату», вы соглашаетесь с <a href="/privacy/" target="_blank" rel="nofollow">политикой конфиденциальности</a> и <a href="/privacy/#consent" target="_blank" rel="nofollow">обработкой персональных данных</a>.</p>
          </form>

          <div class="seasonal-form-success" data-form-success hidden>
            <h3>Спасибо, заявка принята</h3>
            <p>Я проверю дату и свяжусь с вами лично по указанному телефону.</p>
            <a class="btn btn-outline" href={contact.phoneHref} data-seasonal-goal="corporate_phone_click">Позвонить</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Modals />
  <WhatsAppFab />
</BaseLayout>
