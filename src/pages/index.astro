---
import BaseLayout from '@layouts/BaseLayout.astro';
import Benefits from '@components/Benefits.astro';
import CaseProofs from '@components/CaseProofs.astro';
import CTA from '@components/CTA.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';
import Gallery from '@components/Gallery.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Letters from '@components/Letters.astro';
import Modals from '@components/Modals.astro';
import SeasonalPromo from '@components/SeasonalPromo.astro';
import VideoCases from '@components/VideoCases.astro';
import WhatsAppFab from '@components/WhatsAppFab.astro';
import Workflow from '@components/Workflow.astro';
import { siteMeta, structuredData } from '@data/corporate';
---
<BaseLayout
  title={siteMeta.title}
  description={siteMeta.description}
  canonical={siteMeta.url}
  ogImage={siteMeta.ogImage}
  includeMainAssets
  structuredData={structuredData}
>
  <Header />
  <main class="page">
    <Hero />
    <SeasonalPromo />
    <VideoCases />
    <Benefits />
    <CaseProofs />
    <Workflow />
    <Gallery />
    <Letters />
    <FAQ />
    <CTA />
  </main>
  <Footer />
  <Modals />
  <WhatsAppFab />
</BaseLayout>
