---
import { contact } from '@data/corporate';
---
<header class="site-header glass fixed" role="banner">
  <div class="container header-row">
    <a class="logo" href="/">Тимур Громов</a>

    <nav class="main-nav" aria-label="Главное меню"></nav>

    <div class="header__cta">
      <a href={contact.whatsappUrl} class="btn btn-ghost header__phone" target="_blank" rel="noopener" data-cta="whatsapp_header_phone">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M22 16.92V21a2 2 0 0 1-2.18 2A19.73 19.73 0 0 1 3 4.18 2 2 0 0 1 5 2h4.09a1 1 0 0 1 1 .75l1 4a1 1 0 0 1-.27.95l-2.2 2.2a16 16 0 0 0 6.34 6.34l2.2-2.2a1 1 0 0 1 .95-.27l4 1a1 1 0 0 1 .75 1z"/>
        </svg>
        {contact.phoneHuman}
      </a>
      <a class="btn btn-primary wa-btn" href={contact.whatsappUrl} target="_blank" rel="noopener" aria-label="Написать в WhatsApp" data-cta="whatsapp_header">
        WhatsApp
      </a>
    </div>
    <button class="burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"></button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden>
    <a class="btn btn-primary wa-btn--mobile" href={contact.whatsappUrl} target="_blank" rel="noopener" data-cta="whatsapp_mobile">WhatsApp</a>
  </nav>
</header>
