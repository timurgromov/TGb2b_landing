---
interface Props {
  variant: 'formats' | 'workflow';
}

const { variant } = Astro.props;

const photos = {
  formats: {
    base: '/assets/photos/feature/corporate-format',
    width: 1536,
    height: 1024,
    alt: 'Тимур Громов ведёт корпоративную программу',
    testId: 'corporate-format-photo'
  },
  workflow: {
    base: '/assets/photos/feature/corporate-workflow-expanded-v2',
    width: 1536,
    height: 768,
    alt: 'Тимур Громов с микрофоном на мероприятии',
    testId: 'corporate-workflow-photo'
  }
} as const;

const photo = photos[variant];
---

<div id={photo.testId} class={`section-photo-wrap section-photo-wrap--${variant}`} data-testid={photo.testId}>
  <figure
    class={`section-photo sr ${variant === 'workflow' ? 'section-photo--zoomed-out' : ''}`}
  >
    <picture>
      <source
        type="image/avif"
        srcset={`${photo.base}-768.avif 768w, ${photo.base}-1536.avif 1536w`}
        sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
      />
      <source
        type="image/webp"
        srcset={`${photo.base}-768.webp 768w, ${photo.base}-1536.webp 1536w`}
        sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
      />
      <img
        src={`${photo.base}-1536.webp`}
        srcset={`${photo.base}-768.webp 768w, ${photo.base}-1536.webp 1536w`}
        sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
        width={photo.width}
        height={photo.height}
        loading="lazy"
        decoding="async"
        alt={photo.alt}
      />
    </picture>
  </figure>
</div>

<style>
  .section-photo--zoomed-out {
    position: relative;
    isolation: isolate;
  }

  .section-photo--zoomed-out::before {
    content: '';
    position: absolute;
    inset: -18px;
    z-index: -1;
    background: url('/assets/photos/feature/corporate-workflow-expanded-v2-1536.avif') center 18% / cover no-repeat;
    filter: blur(14px) brightness(0.58) saturate(0.82);
    transform: scale(1.06);
  }

  .section-photo--zoomed-out > picture {
    position: relative;
    z-index: 1;
    width: min(92%, max(84%, calc(clamp(300px, 32vw, 430px) * 2.45)));
    height: clamp(300px, 32vw, 430px);
    margin: 0 auto;
  }

  .section-photo--zoomed-out > picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }

  @media (max-width: 768px) {
    .section-photo--zoomed-out::before {
      display: none;
    }

    .section-photo--zoomed-out > picture {
      width: 100%;
      height: auto;
    }

    .section-photo--zoomed-out > picture img {
      height: auto;
      aspect-ratio: 3 / 2;
      object-position: center;
    }
  }
</style>
