---
import BaseLayout from '@layouts/BaseLayout.astro';
import Benefits from '@components/Benefits.astro';
import CaseProofs from '@components/CaseProofs.astro';
import ContextPhoto from '@components/ContextPhoto.astro';
import CTA from '@components/CTA.astro';
import EveningFlow from '@components/EveningFlow.astro';
import FAQ from '@components/FAQ.astro';
import Footer from '@components/Footer.astro';
import Gallery from '@components/Gallery.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Letters from '@components/Letters.astro';
import Modals from '@components/Modals.astro';
import MusicProgram from '@components/MusicProgram.astro';
import SeasonalPromo from '@components/SeasonalPromo.astro';
import ServiceFormats from '@components/ServiceFormats.astro';
import VideoCases from '@components/VideoCases.astro';
import ContactChoice from '@components/ContactChoice.astro';
import MaterialsRequest from '@components/MaterialsRequest.astro';
import Workflow from '@components/Workflow.astro';
import { siteMeta, structuredData } from '@data/corporate';

interface Props {
  portfolio?: boolean;
}

const { portfolio = false } = Astro.props;
const canonical = portfolio ? new URL('/portfolio/', siteMeta.url).href : siteMeta.url;
---
<BaseLayout
  title={siteMeta.title}
  description={siteMeta.description}
  canonical={canonical}
  ogImage={siteMeta.ogImage}
  includeMainAssets
  pageCss="/seasonal.css?v=20261009c"
  pageScript={portfolio ? undefined : '/seasonal.js?v=20261015'}
  noindex={portfolio}
  structuredData={portfolio ? { ...structuredData, url: canonical } : structuredData}
>
  <Header portfolio={portfolio} />
  <main class="page">
    <Hero />
    <SeasonalPromo portfolio={portfolio} />
    <VideoCases />
    <EveningFlow />
    <Benefits />
    <ServiceFormats pricing={!portfolio} />
    <MusicProgram />
    <CaseProofs />
    <Workflow />
    <MaterialsRequest />
    <Gallery />
    <Letters />
    <FAQ />
    <ContextPhoto variant="formats" />
    <CTA />
  </main>
  <Footer />
  <Modals />
  <ContactChoice page="corporate" />
</BaseLayout>
