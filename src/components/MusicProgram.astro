---
interface Props {
  seasonal?: boolean;
}

const { seasonal = false } = Astro.props;
---

<section id="music-program" class="section music-program" data-testid="music-program">
  <div class="container">
    <p class="section__eyebrow sr">Третий пакет — с живой музыкой</p>
    <h2 class="section__title sr">Два вокалиста: три музыкальных блока по 30 минут</h2>
    <p class="section__subtitle music-program__intro sr">Расширение пакета «Ведущий + DJ + звук»: два вокалиста исполняют знакомые песни под профессиональные аранжировки. Состав можно дополнить саксофонистом или гитаристом.</p>

    <div class="music-program__layout sr">
      <div class="music-program__summary">
        <div class="music-program__summary-copy">
          <p class="music-program__label">Живой вокал в программе вечера</p>
          <p class="music-program__lead">Живой музыкальный блок без сметы полной кавер-группы</p>
          <p class="music-program__copy">Артисты работают с нашей командой и подключаются к согласованному комплекту звука. Поэтому не нужно отдельно оплачивать полный состав музыкантов, большой концертный комплект и сценическое оборудование. Музыкальная часть остаётся полноценной, а смета — заметно компактнее, чем у полной кавер-группы.</p>
        </div>
        <picture class="music-program__photo">
          <source srcset="/assets/music/music-program-max.avif" type="image/avif" />
          <img src="/assets/music/music-program-max.webp" width="1200" height="843" loading="lazy" decoding="async" alt="Музыканты с гитарой и саксофоном в расширенном составе" />
        </picture>
      </div>

      <div class="music-program__options" aria-label="Состав третьего пакета">
        <p class="music-program__options-title">Состав третьего пакета</p>
        <article class="music-program__option">
          <span class="music-program__option-label">Базовый состав</span>
          <h3>Два вокалиста</h3>
          <p>Три блока по 30 минут.</p>
        </article>
        <article class="music-program__option">
          <span class="music-program__option-label">Расширенный состав</span>
          <h3>Два вокалиста + саксофонист</h3>
          <p>Саксофонист может встретить гостей на welcome и участвовать в музыкальных блоках.</p>
        </article>
        <article class="music-program__option">
          <span class="music-program__option-label">Максимальный состав</span>
          <h3>Два вокалиста + саксофонист + гитарист</h3>
          <p>Более насыщенный состав для музыкальной части вечера.</p>
        </article>
      </div>
    </div>

    <div class="music-program__cta sr">
      {seasonal ? (
        <a class="btn btn-outline" href="#proverit-datu">Обсудить музыкальный состав</a>
      ) : (
        <button class="btn btn-outline" type="button" data-modal="contact-popup" data-cta="contact_popup_music_program">Обсудить музыкальный состав</button>
      )}
    </div>
  </div>
</section>
