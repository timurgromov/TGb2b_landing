---
import { workflowSteps } from '@data/corporate';
---
<section id="workflow" class="workflow section">
  <div class="container">
    <h2 class="section__title sr">Порядок работы</h2>
    <p class="section__subtitle sr">От первого звонка — до аплодисментов</p>
    <div class="workflow__steps">
      {workflowSteps.map(([title, text], index) => (
        <article class="workflow__step sr" role="group" aria-label={`Этап ${index + 1} из ${workflowSteps.length}`} data-cta={`workflow_step_${index + 1}`}>
          <span class="workflow__badge" aria-hidden="true">{index + 1}</span>
          <div class="workflow__content">
            <h3 class="workflow__title">{title}</h3>
            <p class="workflow__text">{text}</p>
          </div>
        </article>
      ))}
    </div>
    <svg class="workflow__connector" aria-hidden="true" viewBox="0 0 1200 200">
      <defs>
        <linearGradient id="connectorGradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" style="stop-color:var(--accent);stop-opacity:0"></stop>
          <stop offset="100%" style="stop-color:var(--accent);stop-opacity:0.5"></stop>
        </linearGradient>
      </defs>
      <path class="workflow__path" d="M 50 60 Q 250 10 450 60 T 1200 60" stroke="url(#connectorGradient)" stroke-width="2" fill="none" stroke-dasharray="1000" stroke-dashoffset="1000"></path>
    </svg>
  </div>

  <div class="workflow__cta">
    <button class="btn btn-outline" data-contact-open data-contact-form="video" data-form-source="workflow_popup">Назначить встречу</button>
  </div>
</section>
