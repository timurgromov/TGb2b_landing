---
import { contact } from '@data/corporate';

interface Props {
  page?: 'corporate' | 'new_year';
}

const { page = 'corporate' } = Astro.props;
---
<button type="button" class="contact-choice-fab" data-contact-open data-contact-fab data-contact-source="sticky_contact" data-contact-intent="consultation" data-contact-placement="sticky" data-cta-site="corporate" data-cta-page={page} aria-haspopup="dialog" aria-controls="contact-choice-dialog">
  <span aria-hidden="true">✦</span><span>Связаться</span>
</button>

<div class="contact-choice" id="contact-choice-dialog" data-cta-site="corporate" data-cta-page={page} hidden>
  <div class="contact-choice__backdrop" data-contact-close></div>
  <section class="contact-choice__sheet" role="dialog" aria-modal="true" aria-labelledby="contact-choice-title" aria-describedby="contact-choice-description" tabindex="-1">
    <button type="button" class="contact-choice__close" data-contact-close aria-label="Закрыть панель">×</button>
    <p class="contact-choice__eyebrow">ТИМУР ГРОМОВ</p>
    <h2 id="contact-choice-title">{page === 'new_year' ? 'Обсудим новогодний корпоратив' : 'Обсудим ваш корпоратив'}</h2>
    <p id="contact-choice-description" data-contact-description>Выберите удобный способ связи. Я отвечу лично.</p>
    <div class="contact-choice__selection" data-contact-selection hidden>
      <strong data-contact-selection-title></strong>
      <span data-contact-selection-date></span>
      <span data-contact-selection-price></span>
    </div>
    <div class="contact-choice__actions" data-contact-actions>
      <a class="contact-choice__action contact-choice__action--primary" href={`https://calcul.timurgromov.ru/api/v1/site/messenger-start?provider=telegram&mode=start&payload=site_meeting_corporate__${page}__hero`} target="_blank" rel="noopener noreferrer" data-contact-telegram>Написать в Telegram-бот <span aria-hidden="true">↗</span></a>
      <a class="contact-choice__action" href={contact.phoneHref} data-contact-phone>Позвонить <span>{contact.phoneHuman}</span></a>
      <button type="button" class="contact-choice__action" data-contact-callback>Оставить номер <span aria-hidden="true">→</span></button>
    </div>
    <form class="contact-choice__form" data-contact-lead-form hidden>
      <p class="contact-choice__form-title">Оставьте номер — я свяжусь лично</p>
      <label class="contact-choice__field">
        <span>Как к вам обращаться</span>
        <input type="text" name="name" maxlength="120" autocomplete="name" required />
      </label>
      <label class="contact-choice__field">
        <span>Телефон</span>
        <input type="tel" name="phone" maxlength="80" autocomplete="tel" inputmode="tel" required />
      </label>
      <button type="submit" class="contact-choice__submit">Отправить номер</button>
      <p class="contact-choice__status" data-contact-form-status role="status" aria-live="polite"></p>
      <p class="contact-choice__consent">Нажимая «Отправить номер», вы соглашаетесь с <a href="/privacy/" target="_blank" rel="nofollow">политикой конфиденциальности</a> и <a href="/privacy/#consent" target="_blank" rel="nofollow">обработкой персональных данных</a>.</p>
    </form>
    <div class="contact-choice__success" data-contact-success hidden>
      <p>Спасибо, номер получен. Я свяжусь с вами лично.</p>
    </div>
    <p class="contact-choice__note" data-contact-note>Заявка появится после запуска бота. Можно также позвонить или оставить номер.</p>
  </section>
</div>
