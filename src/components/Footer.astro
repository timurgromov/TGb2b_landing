---
import { contact } from '@data/corporate';
---
<footer class="footer sr">
  <div class="container footer__grid">
    <div class="footer__brand">
      <div class="brand">Тимур Громов</div>
      <div class="footer__tagline">Ведущий мероприятий • Москва</div>
    </div>

    <div class="footer-contacts">
      <a href={contact.phoneHref} class="footer-link" data-cta="tel_footer" data-seasonal-goal="corporate_phone_click" title="Нажмите для звонка">{contact.phoneHuman}</a><br />
      <a href={`mailto:${contact.email}`} class="footer-link" data-cta="email_footer">{contact.email}</a>

      <div class="footer-social">
        <a href={contact.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram" class="footer-social__btn" data-cta="social_inst">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zm0 2a3.5 3.5 0 1 0 .001 7.001A3.5 3.5 0 0 0 12 9.5zM18 6.3a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"></path></svg>
        </a>
        <a href={contact.vkUrl} target="_blank" rel="noopener" aria-label="VKontakte" class="footer-social__btn footer-social__btn--vk" data-cta="social_vk">
          <svg viewBox="0 0 48 48" width="20" height="20" fill="currentColor"><path d="M25.26 44.48h-2.94c-12.82 0-20.16-8.77-20.48-23.32h7.1c.21 10.48 4.83 14.93 8.49 15.86V21.16h6.69v9.1c3.62-.39 7.42-4.56 8.71-9.1h6.69c-1.12 6.34-5.8 11.02-9.12 12.93 3.32 1.63 8.65 5.67 10.68 13.39h-7.37c-1.54-5.18-5.39-9.21-10.48-9.75v9.75z"></path></svg>
        </a>
        <a href={contact.youtubeUrl} target="_blank" rel="noopener" aria-label="YouTube" class="footer-social__btn footer-social__btn--yt" data-cta="social_yt">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.4.6A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c2 .6 9.4.6 9.4.6s7.4 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8zM9.6 15.5v-7l6.4 3.5-6.4 3.5z"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="footer__legal">Индивидуальный предприниматель<br />Мамедов Руслан Идрисович<br />ИНН 615491029963 · ОГРНИП 312615430300096</div>
    <p class="footer__copy">© 2026 ИП Мамедов Р.И. Все права защищены.</p>
  </div>
</footer>
