---
import { hero } from '@data/corporate';
import HeroPortraitSlider from '@components/HeroPortraitSlider.astro';
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text sr" id="hero-left">
      <h1><span class="h1-prefix">{hero.title}</span></h1>
      <p class="sub" id="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-tags" id="hero-tags">
        {hero.tags.map((tag) => (
          <span class:list={['tag', tag.className]}>{tag.label}</span>
        ))}
      </div>
      <div class="hero__cta hero-actions" id="hero-actions">
        <button type="button" class="btn btn-primary" data-modal="contact-popup" data-cta="contact_popup_hero">Обсудить корпоратив</button>
        <button class="btn btn-outline" data-modal="video-consult-modal" data-form-source="hero_video" data-cta="video_call_hero">Назначить встречу</button>
      </div>
    </div>
    <HeroPortraitSlider alt={hero.imageAlt} />
  </div>
</section>
