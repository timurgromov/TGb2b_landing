---
import { proofCases } from '@data/corporate';

interface Props {
  seasonal?: boolean;
}

const { seasonal = false } = Astro.props;
const [featuredCase, ...secondaryCases] = proofCases;
---

<section id="proof-cases" class="section proof-cases" data-testid="proof-cases">
  <div class="container">
    <div class="proof-cases__heading">
      <div class="proof-cases__heading-copy">
        <p class="section__eyebrow sr">Подтверждено заказчиками</p>
        <h2 class="section__title sr">Свежие благодарности от компаний</h2>
        <p class="section__subtitle proof-cases__intro sr">
          {seasonal
            ? 'Три самых свежих письма — с датами, подписями и деталями проведённых мероприятий.'
            : 'Три самых свежих письма — с датами, подписями и конкретной обратной связью.'}
        </p>
      </div>
      <a class="btn btn-outline proof-cases__more sr" href="#letters">
        Больше благодарственных писем
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="proof-cases__layout">
      <article class="proof-case proof-case--featured sr" data-proof-priority="featured">
        <button
          class="proof-case__letter"
          type="button"
          data-letter-modal
          data-full={featuredCase.letter}
          aria-label={`Открыть письмо: ${featuredCase.company}`}
        >
          <img src={featuredCase.letter} alt={featuredCase.letterAlt} loading="lazy" decoding="async" />
          <span>Открыть письмо ↗</span>
        </button>
        <div class="proof-case__body">
          <p class="proof-case__flag">Самое свежее письмо</p>
          <div class="proof-case__identity">
            <p class="proof-case__company">{featuredCase.company}</p>
            <span aria-hidden="true">•</span>
            <p class="proof-case__meta">{featuredCase.meta}</p>
          </div>
          <h3>{featuredCase.title}</h3>
          <p>{featuredCase.description}</p>
        </div>
      </article>

      <div class="proof-cases__secondary">
        {secondaryCases.map((item) => (
          <article class="proof-case proof-case--compact sr" data-proof-priority="secondary">
            <button
              class="proof-case__letter"
              type="button"
              data-letter-modal
              data-full={item.letter}
              aria-label={`Открыть письмо: ${item.company}`}
            >
              <img src={item.letter} alt={item.letterAlt} loading="lazy" decoding="async" />
              <span>Открыть письмо ↗</span>
            </button>
            <div class="proof-case__body">
              <div class="proof-case__identity">
                <p class="proof-case__company">{item.company}</p>
                <span aria-hidden="true">•</span>
                <p class="proof-case__meta">{item.meta}</p>
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
