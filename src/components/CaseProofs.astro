---
import { proofCases } from '@data/corporate';
---

<section id="proof-cases" class="section proof-cases" data-testid="proof-cases">
  <div class="container">
    <div class="proof-cases__heading">
      <div class="proof-cases__heading-copy">
        <p class="section__eyebrow sr">Подтверждено письмами</p>
        <h2 class="section__title sr">Корпоративы глазами заказчиков</h2>
        <p class="section__subtitle proof-cases__intro sr">Четыре мероприятия — коротко о формате и обратной связи. Оригиналы писем можно открыть.</p>
      </div>
      <a class="btn btn-outline proof-cases__more sr" href="#letters">
        Все 13 писем
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="proof-cases__grid sr" data-proof-cases-grid>
      {proofCases.map((item) => (
        <article class="proof-case-card" data-proof-case>
          <button
            class="proof-case-card__letter"
            type="button"
            data-letter-modal
            data-full={item.letter}
            data-alt={item.letterAlt}
            aria-label={`Открыть письмо: ${item.company}`}
          >
            <img src={item.letter} alt="" loading="lazy" decoding="async" />
            <span>Открыть письмо <span aria-hidden="true">↗</span></span>
          </button>
          <div class="proof-case-card__body">
            <div class="proof-case-card__identity">
              <p class="proof-case-card__company">{item.company}</p>
              <p class="proof-case-card__meta">{item.meta}</p>
            </div>
            <h3>{item.title}</h3>
            <p class="proof-case-card__excerpt">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
