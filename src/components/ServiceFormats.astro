---
interface Props {
  seasonal?: boolean;
}

const { seasonal = false } = Astro.props;

const formats = [
  {
    name: 'Базовый',
    title: 'Ведущий + DJ',
    items: ['Подготовка программы', 'Ведение вечера', 'DJ и музыкальное сопровождение']
  },
  {
    name: 'С техникой',
    title: 'Ведущий + DJ + звук',
    items: [
      'Подготовка программы',
      'Ведение вечера',
      'DJ и музыкальное сопровождение',
      'Техническое оснащение площадки'
    ]
  },
  {
    name: 'С живой музыкой',
    title: 'Ведущий + DJ + звук + два вокалиста',
    detailsHref: '#music-program',
    items: [
      'Подготовка программы',
      'Ведение вечера',
      'DJ и музыкальное сопровождение',
      'Техническое оснащение площадки',
      'Три блока по 30 минут с профессиональными аранжировками',
      'Музыкальную часть можно дополнить саксофоном или гитарой'
    ]
  }
];
---

<section id="formats" class="section service-formats" data-testid="service-formats">
  <div class="container">
    <p class="section__eyebrow sr">Без лишнего в смете</p>
    <h2 class="section__title sr">Выберите подходящий состав</h2>
    <p class="section__subtitle service-formats__intro sr">DJ всегда работает со мной в связке. Остальной состав зависит от площадки, числа гостей и программы.</p>
    <div class="service-formats__grid">
      {formats.map((format, index) => (
        <article class:list={['service-format', 'sr', { 'service-format--featured': index === 1 }]}>
          <p class="service-format__number">0{index + 1} · {format.name}</p>
          <h3>{format.title}</h3>
          <ul>
            {format.items.map((item) => <li>{item}</li>)}
          </ul>
          {format.detailsHref && <a class="service-format__details" href={format.detailsHref}>Подробнее о живой музыке <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
    <div class="service-formats__cta">
      {seasonal ? (
        <a class="btn btn-outline" href="#proverit-datu">Проверить дату и состав</a>
      ) : (
        <button class="btn btn-outline" type="button" data-modal="contact-popup" data-cta="contact_popup_formats">Обсудить дату и состав</button>
      )}
    </div>
  </div>
</section>
