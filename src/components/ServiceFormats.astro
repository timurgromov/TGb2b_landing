---
interface Props {
  seasonal?: boolean;
}

import { formatRubles, liveMusicAddon, seasonalPriceRows } from '@data/seasonalPricing';

const { seasonal = false } = Astro.props;

const seasonalMinimums = {
  hostDj: Math.min(...seasonalPriceRows.map((row) => row.hostDj)),
  hostDjSound: Math.min(...seasonalPriceRows.map((row) => row.hostDjSound)),
  liveMusic: Math.min(...seasonalPriceRows.map((row) => row.hostDjSound + row.liveMusicAddon)),
  extension: Math.min(...seasonalPriceRows.map((row) => row.extension))
};

const formats = [
  {
    name: 'Базовый',
    title: 'Ведущий + DJ',
    calculatorTitle: 'Ведущий + DJ',
    calculatorNote: 'Подготовка и программа до 5 часов',
    priceKey: 'hostDj',
    items: ['Подготовка программы', 'Ведение вечера', 'DJ и музыкальное сопровождение']
  },
  {
    name: 'С техникой',
    title: 'Ведущий + DJ + звук',
    calculatorTitle: 'Ведущий + DJ + звук',
    calculatorNote: 'Оборудование площадки включено',
    priceKey: 'hostDjSound',
    items: [
      'Подготовка программы',
      'Ведение вечера',
      'DJ и музыкальное сопровождение',
      'Техническое оснащение площадки'
    ]
  },
  {
    name: 'С живой музыкой',
    title: 'Ведущий + DJ + звук + два вокалиста',
    calculatorTitle: 'Два вокалиста · 3 × 30 минут',
    calculatorNote: 'Ведущий, DJ и звук включены',
    priceKey: 'liveMusic',
    detailsHref: '#music-program',
    items: [
      'Подготовка программы',
      'Ведение вечера',
      'DJ и музыкальное сопровождение',
      'Техническое оснащение площадки',
      'Три вокальных блока по 30 минут в исполнении двух вокалистов — под профессиональные аранжировки',
      'Музыкальную часть можно дополнить саксофоном или гитарой'
    ]
  }
];
---

<section id="formats" class="section service-formats" data-testid="service-formats">
  <div class="container">
    <p class="section__eyebrow sr">Без лишнего в смете</p>
    <h2 class="section__title sr">Выберите подходящий состав</h2>
    <p class="section__subtitle service-formats__intro sr">DJ всегда работает со мной в связке. Остальной состав зависит от площадки, числа гостей и программы.</p>
    {seasonal ? (
      <>
        <div class="seasonal-pricing-calculator sr" data-seasonal-pricing data-testid="seasonal-pricing" data-annual-host-dj={seasonalMinimums.hostDj} data-annual-host-dj-sound={seasonalMinimums.hostDjSound} data-annual-live-music-addon={liveMusicAddon} data-annual-extension={seasonalMinimums.extension}>
          <div class="seasonal-pricing-picker">
            <div class="seasonal-pricing-picker__summary" id="seasonal-pricing-hint">
              <strong data-pricing-selected-date>Базовая цена на даты вне декабря 2026</strong>
              <span>Все цены указаны за программу до 5 часов</span>
            </div>
            <label class="seasonal-pricing-picker__control" for="seasonal-pricing-date">
              <span data-pricing-date-action>Выбрать дату</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1 1-1V6a1 1 0 0 1 1-1Z" /></svg>
              <input id="seasonal-pricing-date" type="date" data-pricing-date aria-label="Выбрать дату корпоратива" aria-describedby="seasonal-pricing-hint" />
            </label>
          </div>

          <div class="seasonal-pricing-options" aria-live="polite" aria-label="Стоимость трёх вариантов на выбранную дату">
            {formats.map((format, index) => (
              <article
                class="seasonal-price-option"
                data-pricing-package={format.priceKey}
              >
                <div class="seasonal-price-option__copy">
                  <p class="seasonal-price-option__number">0{index + 1} · {format.name}</p>
                  <h3>{format.calculatorTitle}</h3>
                  <p>{format.calculatorNote}</p>
                </div>
                <div class="seasonal-price-option__quote">
                  <div class="seasonal-price-option__price-line">
                    <span class="seasonal-price-option__date" data-pricing-caption hidden></span>
                    <div class="seasonal-price-option__amount-row">
                      <output
                        class="seasonal-price-option__value"
                        data-pricing-value
                        data-pricing-initial={`от ${formatRubles(seasonalMinimums[format.priceKey])}`}
                      >от {formatRubles(seasonalMinimums[format.priceKey])}</output>
                      <span class="seasonal-price-option__extension">
                        <span>Доп. час</span>
                        <output data-pricing-extension data-pricing-initial={`от ${formatRubles(seasonalMinimums.extension)}`}>от {formatRubles(seasonalMinimums.extension)}</output>
                      </span>
                    </div>
                  </div>
                </div>
                <details class="seasonal-price-option__disclosure">
                  <summary class="seasonal-price-option__toggle">
                    <span class="seasonal-price-option__toggle-closed">Что входит</span>
                    <span class="seasonal-price-option__toggle-open">Скрыть состав</span>
                  </summary>
                  <div class="seasonal-price-option__details">
                    <p class="seasonal-price-option__details-title">{format.title}</p>
                    <ul>
                      {format.items.map((item) => <li>{item}</li>)}
                    </ul>
                    {index > 0 && <p class="seasonal-price-option__equipment">В цену входит комплект звука и DJ-оборудования. Точный состав подтвердим после проверки площадки.</p>}
                    {format.detailsHref && <a class="seasonal-price-option__details-link" href={format.detailsHref}>Подробнее о живой музыке <span aria-hidden="true">→</span></a>}
                  </div>
                </details>
              </article>
            ))}
          </div>

          <div class="seasonal-pricing-result">
            <a href="#proverit-datu">Уточнить доступность даты и состав <span aria-hidden="true">→</span></a>
          </div>
        </div>

      <details class="seasonal-pricing-table sr">
        <summary>Посмотреть цены на все даты декабря</summary>
        <div class="seasonal-pricing-table__wrap">
          <table>
            <caption class="seasonal-pricing-table__caption">Стоимость пятичасовой программы новогоднего корпоратива по датам декабря 2026 года</caption>
            <thead>
              <tr>
                <th scope="col">Даты</th>
                <th scope="col">Ведущий + DJ</th>
                <th scope="col">С оборудованием</th>
                <th scope="col">С живой музыкой</th>
                <th scope="col">Доп. час</th>
              </tr>
            </thead>
            <tbody>
              {seasonalPriceRows.map((row) => (
                <tr
                  data-pricing-row
                  data-date-from={row.fromDay}
                  data-date-to={row.toDay}
                  data-host-dj={row.hostDj}
                  data-host-dj-sound={row.hostDjSound}
                  data-live-music-addon={row.liveMusicAddon}
                  data-extension={row.extension}
                >
                  <th scope="row" data-label="Даты"><span>{row.label}</span><small>{row.weekdays}</small></th>
                  <td data-label="Ведущий + DJ">{row.fromDay === 31 ? 'от ' : ''}{formatRubles(row.hostDj)}</td>
                  <td data-label="С оборудованием">{row.fromDay === 31 ? 'от ' : ''}{formatRubles(row.hostDjSound)}</td>
                  <td data-label="С живой музыкой">от {formatRubles(row.hostDjSound + row.liveMusicAddon)}</td>
                  <td data-label="Доп. час">{formatRubles(row.extension)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="seasonal-pricing-table__note">Цена пакета с двумя вокалистами уже учитывает декабрьскую ставку музыкального состава на выбранную дату. Саксофон и гитара рассчитываются отдельно.</p>
      </details>
      </>
    ) : (
      <>
        <div class="service-formats__grid">
          {formats.map((format, index) => (
            <article class:list={['service-format', 'sr', { 'service-format--featured': index === 1 }]}>
              <p class="service-format__number">0{index + 1} · {format.name}</p>
              <h3>{format.title}</h3>
              <ul>
                {format.items.map((item) => <li>{item}</li>)}
              </ul>
              {format.detailsHref && <a class="service-format__details" href={format.detailsHref}>Подробнее о живой музыке <span aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
        <div class="service-formats__cta">
        <button class="btn btn-outline" type="button" data-contact-open data-contact-source="formats_consultation" data-contact-intent="consultation" data-contact-placement="formats">Обсудить дату и состав</button>
        </div>
      </>
    )}
  </div>
</section>
